<?php

/**
 * Implements hook_install().
 */
function ai_provider_ollama_install() {
  if (!module_load_install('ai_upgrade')) { return []; }
  ai_upgrade_module_install('ai_provider_ollama');
}

/**
 * Migrate legacy provider config from openai_ollama to ai_provider_ollama.
 */
function ai_provider_ollama_update_1000() {
  $old_config_name = 'openai_ollama.settings';
  $new_config_name = 'ai_provider_ollama.settings';

  $old = config($old_config_name);
  $data = $old->get();

  if (!empty($data)) {
    $new = config($new_config_name);
    $data['_config_name'] = $new_config_name;
    $new->setData($data);
    $new->save();
    $old->delete();
  }

  if (module_exists('openai_ollama')) {
    module_disable(['openai_ollama']);
  }

  return t('Migrated legacy ollama configuration to AI provider ollama.');
}

/**
 * Implements hook_requirements().
 */
function ai_provider_ollama_requirements($phase) {
  if (!module_load_install('ai_upgrade')) { return []; }
  return ai_upgrade_module_requirements($phase, 'ai_provider_ollama');
}
