<?php

/**
 * @file
 * Provides Ollama integration for the AI module.
 *
 * Ollama allows you to run LLMs locally on your own hardware.
 * This module integrates Ollama's shared-chat-compatible API with the AI module.
 *
 * @see https://docs.ollama.com/api/ai-compatibility
 */

/**
 * Implements hook_autoload_info().
 */
function ai_provider_ollama_autoload_info() {
  return [
    'AIOllamaAdapter' => 'includes/AIOllamaAdapter.php',
  ];
}

/**
 * Implements hook_ai_embedding_model_quirks().
 *
 * Declares per-model embedding quirks this provider's models require --
 * e.g. nomic-embed-text was trained with "search_query: " / "search_document: "
 * task prefixes and its own model card documents materially worse retrieval
 * without them. Consumers (ai_search) look this registry up by model-name
 * pattern instead of hardcoding per-model checks in their own code, so a
 * future quirk for a different model is a new entry here (or in whichever
 * provider owns that model), not another special case scattered through
 * every caller.
 *
 * @return array
 *   Keyed by a substring pattern matched against the model id. Each entry
 *   may include:
 *   - query_prefix: prepended to text embedded as a search query.
 *   - document_prefix: prepended to text embedded as indexed content.
 */
function ai_provider_ollama_ai_embedding_model_quirks() {
  return [
    'nomic-embed-text' => [
      'query_prefix'    => 'search_query: ',
      'document_prefix' => 'search_document: ',
    ],
  ];
}

/**
 * Implements hook_ai_provider_info().
 */
function ai_provider_ollama_ai_provider_info() {
  return [
    'ollama' => [
      'label' => t('Ollama'),
      'description' => t('Run AI models locally on your own hardware. Supports Llama, Mistral, Phi, and many more open models. No API key required.'),
      'class' => 'AIOllamaAdapter',
      'website' => 'https://ollama.ai/',
      'models_url' => 'https://ollama.ai/library',
    ],
  ];
}

/**
 * Implements hook_config_info().
 */
function ai_provider_ollama_config_info() {
  return [
    'ai_provider_ollama.settings' => [
      'label' => t('Ollama Settings'),
      'group' => t('Configuration'),
    ],
  ];
}

/**
 * Implements hook_ai_provider_settings_alter().
 *
 * Adds Ollama-specific settings to the main AI settings form.
 */
function ai_provider_ollama_ai_provider_settings_alter(&$settings, $context) {
  // Only add settings if Ollama is the selected provider
  if ($context['provider'] !== 'ollama') {
    return;
  }

  // Prefer the central ai.settings providers mapping, fall back to module config.
  $providers_root = config_get('ai.settings', 'providers') ?: [];
  // Use only the provider-specific key 'ollama_base_url'. Do not read/write
  // the generic 'base_url'. Fall back to a reasonable default if the provider
  // setting is not present. (Do NOT read from ai_provider_ollama.settings.)
  $default_base_url = !empty($providers_root['ollama']['ollama_base_url']) ? $providers_root['ollama']['ollama_base_url'] : 'http://localhost:11434';

  $settings['ollama_base_url'] = [
    '#type' => 'textfield',
    '#title' => t('Ollama Server URL'),
    '#default_value' => $default_base_url,
    '#description' => t('The base URL of your Ollama server. Default is http://localhost:11434 for local installations.'),
    '#required' => FALSE,
    '#weight' => 0,
  ];

  $settings['capabilities_link'] = [
    '#type' => 'markup',
    '#markup' => '<p>' . t('Model capabilities are detected using Ollama\'s native API. <strong><a href="@url">Review or override model capabilities &raquo;</a></strong>', [
      '@url' => url('admin/config/ai/settings/capabilities/ollama'),
    ]) . '</p>' . ai_provider_capability_override_notice('ollama'),
    '#weight' => 5,
  ];

  $settings['ollama_help'] = [
    '#type' => 'markup',
    '#markup' => '<div class="description">' .
      t('<h4>Getting Started with Ollama</h4>
      <ol>
        <li>Install Ollama from <a href="https://ollama.ai" target="_blank">ollama.ai</a></li>
        <li>Pull a model: <code>ollama pull llama3.2</code></li>
        <li>Ollama automatically starts an API server on port 11434</li>
        <li>No API key is needed - Ollama runs locally</li>
      </ol>
      <p><strong>Popular models:</strong> llama3.2, mistral, phi3, codellama, gemma2</p>
      <p><a href="https://ollama.ai/library" target="_blank">Browse all models</a></p>') .
      '</div>',
    '#weight' => 10,
  ];

  // Add custom submit handler to save Ollama settings into central ai.settings
  if (isset($context['form'])) {
    $context['form']['#submit'][] = 'ai_provider_ollama_settings_submit';
    // Do not attach a separate persist handler for enabled state; the main
    // ai settings submit handler manages enabled_providers centrally.
  }
}

/**
 * Custom submit handler to save Ollama-specific settings.
 */
function ai_provider_ollama_settings_submit($form, &$form_state) {
  if (isset($form_state['values']['ollama_base_url'])) {
    // Persist into central ai.settings providers mapping so all provider
    // settings live in one place. Use the provider-specific key 'ollama_base_url'
    // and do NOT write the generic 'base_url' nor touch module config.
    $central = config('ai.settings');
    $providers = $central->get('providers') ?: [];
    if (!isset($providers['ollama']) || !is_array($providers['ollama'])) {
      $providers['ollama'] = [];
    }
    $providers['ollama']['ollama_base_url'] = $form_state['values']['ollama_base_url'];
    $central->set('providers', $providers);
    $central->save();

    backdrop_set_message(t('Ollama server URL has been saved to AI settings.'));
  }
}

/**
 * Ensure the Ollama enabled checkbox is persisted when the AI settings
 * form is submitted, even if provider hooks didn't attach a submit handler.
 */
function ai_provider_ollama_form_ai_settings_form_alter(&$form, &$form_state, $form_id) {
  if (!isset($form['#submit']) || !is_array($form['#submit'])) {
    $form['#submit'] = [];
  }
  // We do not attach a separate persist handler for enabled state because
  // the central AI submit handler now records provider enabled flags.
}

/**
 * Fetch available Ollama models using the recommended /api/tags endpoint.
 *
 * @param string $base_url
 *   Base URL of the Ollama server (e.g. http://localhost:11434)
 *
 * @return array
 *   Indexed array of model items (each item is an array/object). Empty on failure.
 */
function ai_provider_ollama_get_models($base_url) {
  $base_url = rtrim($base_url, " /");
  $endpoint = $base_url . '/api/tags';

  try {
    $resp = @backdrop_http_request($endpoint);
    if (empty($resp) || empty($resp->data)) {
      watchdog('ai_provider_ollama', 'No response data from Ollama /api/tags @url', ['@url' => $endpoint], WATCHDOG_DEBUG);
      return [];
    }

    $data = json_decode($resp->data, TRUE);
    if (is_null($data)) {
      watchdog('ai_provider_ollama', 'Failed to decode JSON from Ollama /api/tags @url', ['@url' => $endpoint], WATCHDOG_WARNING);
      return [];
    }

    // If the response contains a 'models' key, prefer that.
    if (isset($data['models']) && is_array($data['models'])) {
      return array_values($data['models']);
    }

    // Some Ollama setups return an array of model objects at top-level.
    if (is_array($data) && array_values($data) === $data) {
      // Ensure items look like model objects (have 'id') or are strings.
      $out = [];
      foreach ($data as $item) {
        if (is_string($item)) {
          $out[] = ['id' => $item];
        }
        elseif (is_array($item)) {
          $out[] = $item;
        }
      }
      return $out;
    }

    // Some responses may have nested shapes; try to find the first array we can use.
    foreach ($data as $k => $v) {
      if (is_array($v)) {
        // If it's a list, convert to indexed items.
        if (array_values($v) === $v) {
          $out = [];
          foreach ($v as $item) {
            if (is_string($item)) {
              $out[] = ['id' => $item];
            }
            elseif (is_array($item)) {
              $out[] = $item;
            }
          }
          if (!empty($out)) {
            return $out;
          }
        }
      }
    }

    return [];
  }
  catch (\Exception $e) {
    watchdog('ai_provider_ollama', 'Exception when contacting Ollama /api/tags: @msg', ['@msg' => $e->getMessage()], WATCHDOG_WARNING);
    return [];
  }
}
